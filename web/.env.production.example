# =============================================================================
# Kuantix 前端「生产构建」环境变量模板
#
# 这是一个模板文件，Vite 不会读它。你需要把它复制成 .env.production 才生效：
#
#   cd web
#   cp .env.production.example .env.production
#   # 然后用编辑器打开 .env.production，把下面的域名换成你自己的
#
# =============================================================================
# 【什么时候填这个文件】
#   必须等后端部署完、拿到云托管服务的访问域名之后再填。
#   顺序反了的话，构建出来的前端包里会写死一个错误地址，
#   打开页面全是「加载失败」，而且必须重新构建才能修好。
# =============================================================================


# -----------------------------------------------------------------------------
# VITE_API_BASE —— 后端 API 的基地址
#
# 填写规则（三条都要满足，错一条页面就打不开数据）：
#   1. 必须以 https:// 开头
#      前端如果部署在 https 域名上，浏览器会拦截所有指向 http 的请求
#      （这叫「混合内容拦截」，是浏览器的安全策略，改不了）
#   2. 必须以 /api/v1 结尾
#      后端所有业务接口都挂在 /api/v1 前缀下
#   3. 结尾不要多加斜杠
#      写成 .../api/v1/ 会导致请求地址出现双斜杠，部分网关会返回 404
#
# 域名从哪里来：
#   腾讯云开发控制台 -> 云托管 -> 你的服务（如 Kuantix-api）
#   -> 服务详情页顶部的「访问地址 / 默认域名」，形如：
#      Kuantix-api-xxxxxxxx.ap-shanghai.run.tcloudbase.com
#
# 正确示例：
#   VITE_API_BASE=https://Kuantix-api-1a2b3c4d.ap-shanghai.run.tcloudbase.com/api/v1
#
# 错误示例：
#   VITE_API_BASE=http://127.0.0.1:8899/api/v1   <- 本地地址，云上打不开
#   VITE_API_BASE=https://xxx.run.tcloudbase.com <- 少了 /api/v1
#   VITE_API_BASE=https://xxx.run.tcloudbase.com/api/v1/  <- 多了结尾斜杠
# -----------------------------------------------------------------------------
VITE_API_BASE=https://<你的CloudRun服务域名>/api/v1


# =============================================================================
# 【不需要配置的东西】
#
# WebSocket 地址：不用单独配。
#   前端会自动把上面的 VITE_API_BASE 里的 http 换成 ws
#   （web/src/api/ws.ts:12-14），也就是说你填了 https://...
#   它自动就变成 wss://.../api/v1/monitor/ws，无需操心。
#
# 数据源密钥 / Token：本项目一个都不需要。
#   行情数据来自通达信公开行情服务器，不需要注册任何账号、不需要申请 key。
# =============================================================================
